<Window x:Class="HDRSnip.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки — HDR Snip"
        Width="620"
        Height="760"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Icon="pack://application:,,,/Resources/app.ico">

    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource SubtleScrollBar}" />
    </Window.Resources>

    <Border Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource StrokeBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="74" Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="22,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Настройки" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="HDR Snip" FontSize="11" Foreground="{StaticResource MutedBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource IconButton}" Margin="0,0,14,0"
                        VerticalAlignment="Center" Click="Cancel_Click" ToolTip="Закрыть">
                    <TextBlock Style="{StaticResource GlyphText}" Text="&#xE711;" FontSize="11" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,0,22,0">
                <StackPanel>

                    <Border Style="{StaticResource SectionCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="СОХРАНЕНИЕ" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}" />
                            <CheckBox x:Name="SaveToFileBox" Style="{StaticResource CheckBoxStyle}"
                                      Content="Сохранять скриншоты в папку" Margin="0,12,0,0"
                                      Checked="SaveToFile_Changed" Unchecked="SaveToFile_Changed" />
                            <TextBlock Text="Каждый готовый скриншот автоматически сохраняется в выбранную папку."
                                       FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                                       Margin="32,4,0,0" TextWrapping="Wrap" />

                            <TextBlock Text="Папка для сохранения" FontSize="11.5"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#12161E"
                                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                                        CornerRadius="8">
                                    <TextBox x:Name="FolderBox" Background="Transparent"
                                             BorderThickness="0" Foreground="{StaticResource TextBrush}"
                                             CaretBrush="{StaticResource TextBrush}"
                                             SelectionBrush="{StaticResource AccentBrush}"
                                             FontSize="13" Padding="10,0" Height="36"
                                             VerticalContentAlignment="Center" />
                                </Border>
                                <Button x:Name="BrowseButton" Grid.Column="1" Content="Обзор…"
                                        Style="{StaticResource SecondaryButton}" Height="38"
                                        Padding="14,0" Margin="10,0,0,0" Click="Browse_Click" />
                            </Grid>

                            <TextBlock Text="Имя файла: «Снимок экрана 2026-10-27 14-30-25 1.png» — дата, время и номер снимка за день."
                                       FontSize="11" Foreground="{StaticResource MutedBrush}"
                                       Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ЗАХВАТ И РЕДАКТОР" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}" />

                            <CheckBox x:Name="ShowToolsBox" Style="{StaticResource CheckBoxStyle}"
                                      Content="Показывать инструменты рисования" Margin="0,12,0,0" />
                            <TextBlock Text="После выделения открывается редактор с кистью, фигурами, текстом, маркером и размытием. Если выключить — скриншот сразу копируется в буфер."
                                       FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                                       Margin="32,4,0,0" TextWrapping="Wrap" />

                            <CheckBox x:Name="ShowCursorBox" Style="{StaticResource CheckBoxStyle}"
                                      Content="Отображать курсор" Margin="0,14,0,0" />
                            <TextBlock Text="Курсор будет виден на снимке там, где он находился при захвате."
                                       FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                                       Margin="32,4,0,0" TextWrapping="Wrap" />

                            <CheckBox x:Name="FullMonitorBox" Style="{StaticResource CheckBoxStyle}"
                                      Content="Скриншот всего монитора" Margin="0,14,0,0" />
                            <TextBlock Text="Захватывает монитор под курсором целиком, без выделения области."
                                       FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                                       Margin="32,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="СИСТЕМА" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}" />
                            <CheckBox x:Name="NotificationsBox" Style="{StaticResource CheckBoxStyle}"
                                      Content="Показывать уведомления" Margin="0,12,0,0" />
                            <TextBlock Text="Всплывающие карточки в правом нижнем углу о копировании и сохранении. Сообщения об ошибках показываются всегда."
                                       FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                                       Margin="32,4,0,0" TextWrapping="Wrap" />
                            <CheckBox x:Name="StartupBox" Style="{StaticResource CheckBoxStyle}"
                                      Content="Запускать при входе в Windows" Margin="0,12,0,0" />
                            <CheckBox x:Name="StartMinimizedBox" Style="{StaticResource CheckBoxStyle}"
                                      Content="Запускать сразу в трей" Margin="0,12,0,0" />
                            <TextBlock Text="При запуске главное окно не открывается — приложение сразу работает в области уведомлений. Автозапуск в Windows также стартует в трей."
                                       FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                                       Margin="32,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ГОРЯЧИЕ КЛАВИШИ" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}" />

                            <TextBlock Text="Выделение области" FontSize="12.5"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" />
                            <Border x:Name="HotkeyField" Focusable="True" Height="42" Margin="0,7,0,0"
                                    Background="#12161E" BorderBrush="{StaticResource StrokeBrush}"
                                    BorderThickness="1" CornerRadius="8" Cursor="Hand"
                                    MouseLeftButtonDown="HotkeyField_MouseLeftButtonDown">
                                <DockPanel Margin="12,0">
                                    <TextBlock x:Name="HotkeyIcon" Style="{StaticResource GlyphText}"
                                               Text="&#xE765;" FontSize="16"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0" />
                                    <TextBlock x:Name="HotkeyText" Text="PrtScr" FontSize="13.5"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>

                            <TextBlock Text="Весь монитор под курсором" FontSize="12.5"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0" />
                            <Border x:Name="FullMonitorHotkeyField" Focusable="True" Height="42" Margin="0,7,0,0"
                                    Background="#12161E" BorderBrush="{StaticResource StrokeBrush}"
                                    BorderThickness="1" CornerRadius="8" Cursor="Hand"
                                    MouseLeftButtonDown="FullMonitorHotkeyField_MouseLeftButtonDown">
                                <DockPanel Margin="12,0">
                                    <TextBlock x:Name="FullMonitorHotkeyIcon" Style="{StaticResource GlyphText}"
                                               Text="&#xE765;" FontSize="16"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0" />
                                    <TextBlock x:Name="FullMonitorHotkeyText" Text="Ctrl+PrtScr" FontSize="13.5"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>

                            <TextBlock Text="Нажмите на поле и введите сочетание. Esc — отмена. Print Screen перехватывается даже если Windows назначила его Snipping Tool."
                                       FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                                       Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="22,10,22,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ErrorText" Grid.Column="0" Foreground="{StaticResource AccentBrush}"
                           FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />

                <Button Grid.Column="1" Content="Отмена" Style="{StaticResource SecondaryButton}"
                        Width="120" Height="42" Click="Cancel_Click" />
                <Button Grid.Column="2" Content="Сохранить" Style="{StaticResource AccentButton}"
                        Width="140" Height="42" Margin="10,0,0,0" Click="Save_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
