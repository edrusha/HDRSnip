<Window x:Class="HDRSnip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HDR Snip"
        Width="480"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Icon="pack://application:,,,/Resources/app.ico">

    <Border Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource StrokeBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="86" Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="11"
                        Background="#1B212B" Margin="20,0,12,0" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Resources/app.png" Width="30" Height="30" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="HDR Snip" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Скриншоты с корректной передачей HDR"
                               FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource IconButton}" Margin="0,0,2,0"
                        VerticalAlignment="Center" Click="Minimize_Click" ToolTip="Свернуть">
                    <TextBlock Style="{StaticResource GlyphText}" Text="&#xE921;" FontSize="11" />
                </Button>

                <Button Grid.Column="3" Style="{StaticResource IconButton}" Margin="0,0,14,0"
                        VerticalAlignment="Center" Click="Close_Click" ToolTip="Скрыть в трей">
                    <TextBlock Style="{StaticResource GlyphText}" Text="&#xE711;" FontSize="11" />
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Margin="20,6,20,18">

                <Button Style="{StaticResource AccentButton}" Height="66" Padding="20,0"
                        Click="Capture_Click" HorizontalContentAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource GlyphText}" Text="&#xE722;" FontSize="30"
                                   Foreground="White" Margin="0,0,16,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock Text="Сделать скриншот" FontSize="16" FontWeight="SemiBold"
                                       Foreground="White" TextWrapping="NoWrap" />
                            <TextBlock x:Name="HotkeyHint" Text="PrtScr" FontSize="11.5" Opacity="0.85"
                                       Foreground="White" Margin="0,1,0,0" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Style="{StaticResource SecondaryButton}" Height="50" Margin="0,10,0,0"
                        Padding="20,0" Click="CaptureFullMonitor_Click"
                        HorizontalContentAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource GlyphText}" Text="&#xE7F4;" FontSize="22"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock Text="Скриншот всего монитора" FontSize="13" TextWrapping="NoWrap" />
                            <TextBlock x:Name="FullMonitorHotkeyHint" Text="Ctrl+PrtScr" FontSize="10.5"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,1,0,0"
                                       TextWrapping="NoWrap" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Style="{StaticResource SecondaryButton}" Height="50" Margin="0,8,0,0"
                        Padding="20,0" Click="CaptureWindow_Click"
                        HorizontalContentAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource GlyphText}" Text="&#xE737;" FontSize="22"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock Text="Снимок окна" FontSize="13" TextWrapping="NoWrap" />
                            <TextBlock Text="Наведите на окно и щёлкните" FontSize="10.5"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,1,0,0"
                                       TextWrapping="NoWrap" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Border Style="{StaticResource SectionCard}" Margin="0,18,0,0">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="МОНИТОРЫ" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="HdrSummary" DockPanel.Dock="Right" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <StackPanel x:Name="MonitorsPanel" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Height="46"
                            Click="Settings_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource GlyphText}" Text="&#xE713;" FontSize="15"
                                       Margin="0,0,9,0" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="Настройки" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="46"
                            Margin="10,0,0,0" Click="Folder_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource GlyphText}" Text="&#xE838;" FontSize="15"
                                       Margin="0,0,9,0" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="Открыть папку" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Margin="0,16,0,0">
                    <TextBlock x:Name="SaveHint" FontSize="11" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Style="{StaticResource LinkButton}" Content="Выход" HorizontalAlignment="Right"
                            Click="Exit_Click" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
